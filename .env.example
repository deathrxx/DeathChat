# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection
# If left blank in development, an embedded in-memory MongoDB will be used automatically.
MONGODB_URI=mongodb://localhost:27017/deathchat

# Security & CORS
# Comma-separated list of allowed origins (e.g. http://localhost:3000,http://localhost:5173)
ALLOWED_ORIGINS=*

# Session and Rate Limiting
SESSION_SECRET=deathchat_ephemeral_secret_key_change_in_production
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
MESSAGE_RATE_LIMIT_MAX=30
